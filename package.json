{
  "name": "aurum-original-games",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types tests/rules.test.ts",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:local": "wrangler d1 migrations apply aurum-db --local",
    "db:remote": "wrangler d1 migrations apply aurum-db --remote",
    "seed:local": "wrangler d1 execute aurum-db --local --file=seed.sql",
    "seed:remote": "wrangler d1 execute aurum-db --remote --file=seed.sql"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.14.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "phaser": "^3.90.0",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@cloudflare/workers-types": "^5.20261101.1",
    "wrangler": "^4.45.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0"
  },
  "type": "module"
}
