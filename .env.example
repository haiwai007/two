# Use .dev.vars for Wrangler locally; wrangler secret put for production secrets.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
REQUIRE_TURNSTILE=true
# GitHub Actions secrets, never put in public bundles:
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Build-only credentials for direct Cloudflare Workers Builds (never runtime vars):
AURUM_CF_API_TOKEN=
AURUM_CF_ACCOUNT_ID=
